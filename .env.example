# Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://aemtliplan:aemtliplan@localhost:5433/aemtliplan"

# better-auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# "true" = users must confirm their email before they can sign in
AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# Email (empty = mails are printed to the server log)
SMTP_URL=""
MAIL_FROM="Ämtliplan <noreply@example.com>"

# MiData OAuth (leave empty to disable MiData login)
MIDATA_URL="https://db.scout.ch"
MIDATA_CLIENT_ID=""
MIDATA_CLIENT_SECRET=""

# "off" disables the automatic rotation ticker (used in tests)
ROTATION_SCHEDULER="on"

# "off" disables better-auth rate limiting (API tests only)
AUTH_RATE_LIMIT="on"
