{
  "type": "module",
  "name": "nuxt-app",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "prettier": "npx prettier --write .",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@types/node": "^24.7.1",
    "@types/nodemailer": "8.0.2",
    "@types/sortablejs": "1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "^9.37.0",
    "eslint-plugin-vitest": "^0.5.4",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "happy-dom": "21.0.3",
    "nuxt": "4.6.2",
    "nuxt-security": "2.5.1",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  },
  "dependencies": {
    "@eslint/js": "^9.34.0",
    "@iconify-json/lucide": "1.2.145",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "@prisma/client": "^6.17.1",
    "better-auth": "1.7.10",
    "croner": "9.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "nodemailer": "10.1.7",
    "tailwindcss": "4.3.3",
    "uqr": "0.1.3",
    "vue-draggable-plus": "0.6.1",
    "vue-eslint-parser": "^10.2.0",
    "zod": "^4.1.1"
  },
  "allowScripts": {
    "@prisma/client@6.17.1": true,
    "@prisma/engines@6.17.1": true,
    "prisma@6.17.1": true,
    "esbuild@0.25.10": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.11.1": true,
    "vue-demi@0.14.10": true
  }
}
